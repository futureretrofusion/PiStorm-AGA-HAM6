@@ -609,7 +621,54 @@ void mmu_map(uintptr_t phys, uintptr_t virt, uintptr_t length, uint32_t attr_low
 
 void mmu_unmap(uintptr_t virt, uintptr_t length)
 {
-    (void)virt;
-    (void)length;
+    /* AGA-PISTORM: clear leaf entries over the range - 4K pages, or whole 2M
+       blocks when the range covers one. A partial 2M block gets split first
+       with put_4k_page, one page at a time, then cleared. Slow as hell. */
     DMAP(kprintf("mmu_unmap(%p, %x)\n", virt, length));
+    struct mmu_page *root;
+    if (virt & 0xffff000000000000) {
+        __asm__ volatile("mrs %0, TTBR1_EL1":"=r"(root));
+    } else {
+        __asm__ volatile("mrs %0, TTBR0_EL1":"=r"(root));
+    }
+    root = (struct mmu_page *)((uintptr_t)root + PHYS_VIRT_OFFSET);
+
+    while (length >= 4096)
+    {
+        int idx_l1 = (virt >> 30) & 0x1ff;
+        int idx_l2 = (virt >> 21) & 0x1ff;
+        int idx_l3 = (virt >> 12) & 0x1ff;
+        uint64_t e1 = root->mp_entries[idx_l1];
+        if ((e1 & 3) != 3) { virt += 4096; length -= 4096; continue; }   /* unmapped or 1G block: leave */
+        struct mmu_page *l2 = (struct mmu_page *)((e1 & 0x7ffffff000ULL) + PHYS_VIRT_OFFSET);
+        uint64_t e2 = l2->mp_entries[idx_l2];
+        if ((e2 & 3) == 1)
+        {
+            if ((virt & 0x1fffff) == 0 && length >= 0x200000) {
+                l2->mp_entries[idx_l2] = 0;
+                virt += 0x200000; length -= 0x200000;
+                continue;
+            }
+            /* split the block into 4K pages, then fall through and clear one */
+            uint32_t attr_low = (uint32_t)(e2 & 0xfff) & ~3u;
+            uint32_t attr_high = (uint32_t)(e2 >> 52);
+            uintptr_t base_phys = e2 & 0x0000ffffffe00000ULL;
+            uintptr_t base_virt = virt & ~0x1fffffULL;
+            for (int i = 0; i < 512; i++)
+                put_4k_page(base_phys + ((uintptr_t)i << 12), base_virt + ((uintptr_t)i << 12), attr_low, attr_high);
+            e2 = l2->mp_entries[idx_l2];
+        }
+        if ((e2 & 3) == 3)
+        {
+            struct mmu_page *l3 = (struct mmu_page *)((e2 & 0x7ffffff000ULL) + PHYS_VIRT_OFFSET);
+            l3->mp_entries[idx_l3] = 0;
+        }
+        virt += 4096; length -= 4096;
+    }
+
+    __asm__ volatile(
+"       dsb     ish                 \n"
+"       tlbi    VMALLE1IS           \n"
+"       dsb     sy                  \n"
+"       isb                         \n");
 }
