+/* AGA-PISTORM: chipset core on core 3 uses the bus (audio DAC loops), 68k
+   trap path uses it on core 0, so the public bus calls get serialised. Same
+   wrappers live in ps_protocol.c for the other boards. */
+/* AGA-PISTORM bus mutex.
+   ps_bus_lock is a plain NON-RECURSIVE spinlock, so nothing reachable from a
+   *_nolock / *_int function may call the wrappers below - it would spin on a
+   lock it already holds. Which is exactly what happened: the port renamed
+   the primitives to _nolock and made ps_read_8/16/32 the wrappers, but left
+   the internal call sites on the old names, so they got the wrappers. 68k
+   deadlocked on its first longword read, machine hung on the Emu68 logo.
+   Fuck knows how long that took to find. ps_memtest/ps_buptest call the
+   wrappers on purpose: top level, not under the lock. */
+volatile char ps_bus_lock __attribute__((aligned(64)));
+/* Not static: GetIPLLevel in ExecutionLoop.c drives the same GPIO pins and
+   has to hold the same lock. Without the write buffer it held nothing, and
+   one status read colliding with a core-3 audio write was enough to wedge
+   the CPLD - every bus read returned $FF/$00 after that, so the CIA could
+   never be acked and the sandbox lost keyboard, timers and at boot the
+   whole damn machine. */
+void ps_bus_acquire(void) { while (__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE)) __asm__ volatile("yield"); }
+void ps_bus_release(void) { __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE); }
+unsigned int ps_read_8(unsigned int address) { ps_bus_acquire(); unsigned int r = ps_read_8_nolock(address); ps_bus_release(); return r; }
+unsigned int ps_read_16(unsigned int address) { ps_bus_acquire(); unsigned int r = ps_read_16_nolock(address); ps_bus_release(); return r; }
+unsigned int ps_read_32(unsigned int address) { ps_bus_acquire(); unsigned int r = ps_read_32_nolock(address); ps_bus_release(); return r; }
+uint64_t ps_read_64(unsigned int address) { ps_bus_acquire(); uint64_t r = ps_read_64_nolock(address); ps_bus_release(); return r; }
+uint128_t ps_read_128(unsigned int address) { ps_bus_acquire(); uint128_t r = ps_read_128_nolock(address); ps_bus_release(); return r; }
+void ps_write_8(unsigned int address, unsigned int data) { ps_bus_acquire(); ps_write_8_nolock(address, data); ps_bus_release(); }
+void ps_write_16(unsigned int address, unsigned int data) { ps_bus_acquire(); ps_write_16_nolock(address, data); ps_bus_release(); }
+void ps_write_32(unsigned int address, unsigned int data) { ps_bus_acquire(); ps_write_32_nolock(address, data); ps_bus_release(); }
+void ps_write_64(unsigned int address, uint64_t data) { ps_bus_acquire(); ps_write_64_nolock(address, data); ps_bus_release(); }
+void ps_write_128(unsigned int address, uint128_t data) { ps_bus_acquire(); ps_write_128_nolock(address, data); ps_bus_release(); }
